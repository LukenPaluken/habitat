# ==============================================================================
# Habitat - Environment Variables Template (.env.example)
# Copy this file to `.env` or `.env.local` and configure with your local values.
# ==============================================================================

# PostgreSQL Database Connection String
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/habitat"

# Better Auth Configuration
# Generate a secret: `openssl rand -base64 32` or any random 32+ char string
BETTER_AUTH_SECRET="habitat-development-secret-key-min-32-chars-length"
BETTER_AUTH_URL="http://localhost:3000"

# Public App URL (Frontend Base URL)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# UploadThing (Media & Image Uploads)
UPLOADTHING_TOKEN="your-uploadthing-token"
UPLOADTHING_SECRET="your-uploadthing-secret"
UPLOADTHING_APP_ID="your-uploadthing-app-id"
